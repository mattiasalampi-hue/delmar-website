# Qui dentro ci sono solo funzioni: chiamarle da fuori non fa niente.
# Ma non c'e' motivo che qualcuno possa scaricarle e leggersi come sono
# fatte le impronte dei visitatori.
#
# NB: questo file va scritto SENZA BOM. La prima versione era stata
# salvata con PowerShell -Encoding utf8, che il BOM lo mette: Apache non
# riesce a interpretare la riga iniziale e risponde 500 su tutta la
# cartella invece di 403. Un errore del server al posto di un divieto,
# e la differenza si vede solo provando l'indirizzo.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
