# Sito DelMar — regole del server.
#
# CREDENZIALI. config.php contiene utente e password del servizio di
# posta. Oggi non si vedrebbe comunque, perche' PHP lo esegue e
# restituisce una pagina vuota, ma quella e' una difesa che dipende da
# PHP: basta un modulo disattivato o un aggiornamento del server e il
# file verrebbe servito come TESTO, password compresa, a chiunque ne
# indovini il nome. Sarebbe stato meglio tenerlo fuori dalla cartella del
# sito, ma questo hosting non permette di scrivere un livello sopra:
# questa regola e' il rimedio, e non dipende da PHP.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# Stessa protezione per i pezzi interni della spedizione. Non contengono
# credenziali, ma nessuno deve poterli chiamare da fuori: chiamati da
# soli non fanno niente (definiscono solo funzioni), e questa regola non
# tocca le require di invia.php — quelle sono letture di file sul disco,
# non richieste HTTP, e passano comunque.
# config.esempio.php e' il modello con le istruzioni su dove stanno le
# credenziali vere: e' pubblico su GitHub, ma qui non serve a nessuno.
<FilesMatch "^(smtp|posta|email|config\.esempio)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Compressione: il sito e' fatto di testo pesante — 74 KB di script e
# 69 di stile — che compresso scende a circa un quinto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Durata in cache. Le risorse hanno il numero di versione nell'indirizzo
# (style.css?v=91), quindi si possono tenere a lungo senza rischiare che
# qualcuno resti con la copia vecchia: cambiando il numero cambia
# l'indirizzo. Le pagine invece devono essere sempre fresche
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType video/mp4               "access plus 6 months"
  # I caratteri ora li serviamo noi invece di prenderli da Google: sono
  # immutabili e vanno tenuti a lungo, o si perde il vantaggio di averli
  # portati dentro
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Le sei pagine di catalogo che l'alberatura nuova non ha piu'.
#
# Erano indirizzi indicizzati, alcuni da mesi, e "Filetti congelati" e
# "Prodotti per crudi di pesce" erano fra le pagine con piu' visite del
# catalogo. Senza queste righe diventano sei 404: Google le toglie
# dall'indice e chi le aveva salvate fra i preferiti sbatte contro un
# muro. Con il 301 l'autorita' accumulata passa alla pagina che ha preso
# il loro posto.
#
# RedirectMatch e non Redirect: Redirect confronta il PREFISSO, quindi
# /catalogo/catalogo-fresco.html.bak verrebbe rediretto anche lui con la
# coda appiccicata in fondo. Le ancore ^...$ chiudono la porta.
#
# E dentro IfModule come tutto il resto di questo file: un Redirect senza
# guardia, se mod_alias e' spento, non e' una riga ignorata ma un errore
# fatale di configurazione — Apache risponde 500 su TUTTO il sito, non
# solo su questi sei indirizzi.
<IfModule mod_alias.c>
  # Cinque vanno al cluster dove i prodotti sono finiti davvero: chi cercava
  # un filetto di merluzzo deve trovarsi davanti il merluzzo, non un elenco
  # di dieci cataloghi da cui ricominciare.
  RedirectMatch 301 "^/catalogo/catalogo-fresco\.html$"     /catalogo/catalogo-pesce.html
  RedirectMatch 301 "^/catalogo/catalogo-filetti\.html$"    /catalogo/catalogo-pesce.html
  RedirectMatch 301 "^/catalogo/catalogo-affumicati\.html$" /catalogo/catalogo-pesce.html
  RedirectMatch 301 "^/catalogo/catalogo-crudo\.html$"      /catalogo/catalogo-pesce.html
  RedirectMatch 301 "^/catalogo/catalogo-dessert\.html$"    /catalogo/catalogo-dolci-e-pasticceria.html

  # "Patate, basi pizza e contorni" e' l'eccezione, e va detto: le sue voci
  # si sono sparpagliate su cinque cluster — patate 2, panificati 3, pasta 3,
  # verdure 1, gastronomia 1. Mandare tutti su "Patate e fritti" vuol dire
  # accogliere con 2 prodotti su 10 chi arrivava cercando le basi pizza o il
  # minestrone. La sezione dell'indice li contiene tutti e cinque.
  RedirectMatch 301 "^/catalogo/catalogo-cucina\.html$"      /catalogo/prodotti.html#per-la-cucina
</IfModule>
